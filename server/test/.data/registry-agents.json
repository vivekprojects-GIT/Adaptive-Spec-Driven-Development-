[
  {
    "id": "agent.selenium-java-analyzer",
    "name": "Selenium Java Analyzer",
    "capability": "source.analyze.selenium-java",
    "description": "Parses Java Selenium sources into a technology-neutral source model: suites, test cases, locators, actions, assertions, waits.",
    "inputs": [
      "artifacts:java"
    ],
    "outputs": [
      "analysis/source-model.json"
    ],
    "impl": "seleniumJavaAnalyzer",
    "tags": [
      "selenium",
      "java",
      "analysis"
    ],
    "maturity": "proven",
    "source": "registry"
  },
  {
